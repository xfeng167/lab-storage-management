APP_NAME="Lab Storage Management API"
DEBUG=false
TOKEN_TTL_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
# Comma-separated browser origins when the production frontend uses another domain.
CORS_ORIGINS=
# Used only by `python -m src.cli bootstrap-admin`; inject as deployment secrets.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Required. Inject this value from the deployment secret store; do not commit it.
# Local development example:
# DATABASE_URL=mysql+pymysql://lab_user:lab_password@localhost:3306/lab_storage_db
